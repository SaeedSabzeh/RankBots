# Copy to .env and fill in. Never commit .env.

# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the session pooler (port 5432) or a direct connection; asyncpg needs session mode.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# One token per bot from @BotFather. A bot runs only if its token is set.
BOT_TOKEN_CAT=

# Webhooks (Render). Any long random string; the service and scripts/set_webhooks.py must
# use the same one. Each bot's secret is derived from it and the bot's token.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# The service's https URL, e.g. https://rank-bots.onrender.com. Only scripts/set_webhooks.py uses it.
PUBLIC_URL=
