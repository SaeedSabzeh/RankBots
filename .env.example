# Copy to .env and fill in. Never commit .env.

# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the session pooler (port 5432) or a direct connection; asyncpg needs session mode.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# One token per bot from @BotFather. A bot runs only if its token is set.
BOT_TOKEN_CAT=
